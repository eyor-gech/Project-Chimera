# Project Chimera — local environment template
#
# Copy to `.env` and fill in real values:
#   cp .env.example .env
#
# `.env` is git-ignored and excluded from the Docker build context
# (see .gitignore / .dockerignore). NEVER commit real credentials.

# API key for OpenRouter (OpenAI-compatible gateway).
# Used by runtime/llm_client.py -> skills/skill_generate_content.py
OPENROUTER_API_KEY=

# --- Local Ollama (no OpenRouter account needed) ---------------------------
# Ollama exposes an OpenAI-compatible API. Use 127.0.0.1 when running directly
# on the host; use host.docker.internal inside a container. The Makefile injects
# the Docker address automatically for `make demo` / `make streamlit`.
#   ollama pull llama3.1
# CHIMERA_OPENROUTER_BASE_URL=http://127.0.0.1:11434/v1
# CHIMERA_MODEL_CHAIN=llama3.1
# CPU inference is slow. If a draft takes longer than CHIMERA_LLM_TIMEOUT the
# request fails and generation silently degrades to the offline stub, so set a
# generous timeout for local models.
# CHIMERA_LLM_TIMEOUT=300
#
# Optional overrides (sensible defaults are applied when unset)
# OpenRouter base URL
# CHIMERA_OPENROUTER_BASE_URL=https://openrouter.ai/api/v1
#
# Comma-separated model fallback chain, tried in order.
# Free-first; the paid model is only a last-resort safety net:
#   google/gemma-4-26b-a4b-it:free  (primary)
#   liquid/lfm-2.5-2.6b:free
#   cohere/north-mini-code:free
#   openai/gpt-4o-mini
# CHIMERA_MODEL_CHAIN=google/gemma-4-26b-a4b-it:free,liquid/lfm-2.5-2.6b:free,cohere/north-mini-code:free,openai/gpt-4o-mini
#
# NOTE: OpenRouter free keys allow 50 free-model requests per day. Once that
# quota is spent the chain falls through to openai/gpt-4o-mini and consumes
# credits. Each draft reports the serving model in its `generated_by` field.
#
# Request timeout in seconds (default 45)
# CHIMERA_LLM_TIMEOUT=45
#
# Retries per model when the provider returns HTTP 429, and the first backoff
# delay in seconds (doubles per retry). Defaults: 2 retries, 1.5s.
# CHIMERA_LLM_RETRIES=2
# CHIMERA_LLM_RETRY_DELAY=1.5
#
# Set to 1 to force the deterministic offline stub (used by the test suite)
# CHIMERA_OFFLINE=0
